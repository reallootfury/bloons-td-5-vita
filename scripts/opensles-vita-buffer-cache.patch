diff --git a/libopensles/IEngine.c b/libopensles/IEngine.c
--- a/libopensles/IEngine.c
+++ b/libopensles/IEngine.c
@@ -32,6 +32,9 @@ static SLresult IEngine_AllocateBufferQueueArray(IBufferQueue *bufferQueue)
