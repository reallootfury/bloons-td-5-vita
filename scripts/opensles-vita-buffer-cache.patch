 /** Determine the state of the audio player or audio recorder associated with a buffer queue.
@@ -59,6 +63,17 @@ void IBufferQueue_ReleaseArrayBuffers(IBufferQueue *this)
     }
 }
 
+void IBufferQueue_ResetArrayBuffers(IBufferQueue *this)
+{
+    if ((NULL == this) || (NULL == this->mArray)) {
+        return;
+    }
+
+    for (unsigned i = 0; i < this->mNumBuffers + 1; ++i) {
+        BufferHeader_consume(&this->mArray[i]);
+    }
+}
+
 SLresult IBufferQueue_Enqueue(SLBufferQueueItf self, const void *pBuffer, SLuint32 size)
 {
     SL_ENTER_INTERFACE
@@ -88,7 +103,7 @@ SLresult IBufferQueue_Enqueue(SLBufferQueueItf self, const void *pBuffer, SLuint
             const uint32_t bits = this->bps;
             const uint32_t bytes_per_sample = bits / 8U;
             const uint32_t input_frame_size = channels * bytes_per_sample;
-            void *ownedBuffer = NULL;
+            void *ownedBuffer = oldRear->mOwnedBuffer;
 
             if (input_rate == 0 || (channels != 1 && channels != 2) ||
                     (bits != 8 && bits != 16) || input_frame_size == 0 ||
@@ -113,12 +128,28 @@ SLresult IBufferQueue_Enqueue(SLBufferQueueItf self, const void *pBuffer, SLuint
             const uint32_t output_size = output_frames * 4U;
 
             if (input_rate != output_rate || channels != 2 || bits != 16) {
-                ownedBuffer = malloc(output_size);
-                if (NULL == ownedBuffer) {
-                    ++opensles_vita_enqueue_failures;
-                    interface_unlock_exclusive(this);
-                    result = SL_RESULT_RESOURCE_ERROR;
-                    goto fail;
+                if (oldRear->mOwnedCapacity < output_size) {
+                    const SLuint32 previous_capacity = oldRear->mOwnedCapacity;
+                    void *grown_buffer = realloc(ownedBuffer, output_size);
+                    if (NULL == grown_buffer) {
+                        ++opensles_vita_enqueue_failures;
+                        interface_unlock_exclusive(this);
+                        result = SL_RESULT_RESOURCE_ERROR;
+                        goto fail;
+                    }
+                    ownedBuffer = grown_buffer;
+                    oldRear->mOwnedBuffer = grown_buffer;
+                    oldRear->mOwnedCapacity = output_size;
+                    if (previous_capacity == 0) {
+                        ++opensles_vita_resample_allocations;
+                    } else {
+                        ++opensles_vita_resample_grows;
+                    }
+                } else {
+                    ++opensles_vita_resample_reuses;
+                }
+                if (output_size > opensles_vita_resample_max_bytes) {
+                    opensles_vita_resample_max_bytes = output_size;
                 }
 
                 int16_t *dst = (int16_t *)ownedBuffer;
@@ -152,7 +184,7 @@ SLresult IBufferQueue_Enqueue(SLBufferQueueItf self, const void *pBuffer, SLuint
                 }
                 pBuffer = ownedBuffer;
             }
-            assert(NULL == oldRear->mOwnedBuffer);
+            assert(NULL == oldRear->mBuffer && 0 == oldRear->mSize);
             oldRear->mBuffer = pBuffer;
             oldRear->mSize = output_size;
             oldRear->mOwnedBuffer = ownedBuffer;
