diff --git a/libopensles/sles_allinclusive.h b/libopensles/sles_allinclusive.h
--- a/libopensles/sles_allinclusive.h
+++ b/libopensles/sles_allinclusive.h
@@ -208,6 +208,7 @@ typedef struct {
     const void *mBuffer;
     SLuint32 mSize;
     void *mOwnedBuffer;
+    SLuint32 mOwnedCapacity;
 } BufferHeader;
 
 static inline void BufferHeader_reset(BufferHeader *header)
@@ -216,6 +217,16 @@ static inline void BufferHeader_reset(BufferHeader *header)
     header->mBuffer = NULL;
     header->mSize = 0;
     header->mOwnedBuffer = NULL;
+    header->mOwnedCapacity = 0;
+}
+
+/* The Vita backend converts queued Android PCM into an owned stereo buffer.
+ * Keep that allocation attached to its ring slot after consumption so the
+ * next effect enqueue can reuse it without touching the heap. */
+static inline void BufferHeader_consume(BufferHeader *header)
+{
+    header->mBuffer = NULL;
+    header->mSize = 0;
 }
 
 static inline void BufferHeader_release(BufferHeader *header)
@@ -1357,3 +1368,4 @@ extern void IBufferQueue_Destroy(IBufferQueue *this);
 extern void IBufferQueue_ReleaseArrayBuffers(IBufferQueue *this);
+extern void IBufferQueue_ResetArrayBuffers(IBufferQueue *this);
 
