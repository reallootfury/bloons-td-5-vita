# Unified-diff payloads contain significant leading markers that Git's outer
# diff would otherwise misclassify as whitespace errors.
*.patch -whitespace

# Keep source and documentation text consistent across Windows and WSL clones.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
